{
  // Cloudflare Worker: the static export in out/ served as assets, with
  // worker/index.ts handling /api/* (the CowTicket proxies in functions/).
  // Used by `pnpm preview` (wrangler dev) and `pnpm deploy` (wrangler deploy).
  // Secrets (TICKET_API_KEY etc.) are NOT set here — see README.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "children-book-fest-2026",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // Next's export writes /event/x.html; serve it at /event/x like Pages did.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Only API calls run the Worker; every other request is answered from the
    // asset store without an invocation (free, and faster).
    "run_worker_first": ["/api/*"]
  },
  // Plain (non-secret) runtime variables. `wrangler deploy` replaces the
  // Worker's vars with this block on every deploy, so anything set only in
  // the dashboard is lost — keep them here. TICKET_API_KEY is a SECRET and is
  // deliberately absent: set it once with `wrangler secret put TICKET_API_KEY`
  // or in the dashboard; deploys never touch secrets. NEXT_PUBLIC_SITE_URL is
  // a BUILD variable (baked into the HTML), not a runtime one.
  "vars": {
    "TICKET_API_URL": "https://api.cow-ticket.dev",
    "TICKET_ACCOUNT_ID": "my-merchant"
  },
  "observability": { "enabled": true }
}
