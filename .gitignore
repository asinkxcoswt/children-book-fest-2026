# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# wrangler local state
.wrangler/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# Client originals: multi-megabyte reference files that never ship. The
# trimmed, downsized sources the site actually uses live in image-src/content/zones
# and image-src/content/mascots. Keep the originals in the shared drive.
image-src/content/characters/
public/content/characters/
image-src/**/*.psd
